@model HotelWeb.Models.Booking
@{ ViewData["Title"] = "New Booking"; }

<div class="card-box form-card">
    <h3 class="mb-4 fw-bold">New Booking</h3>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger d-flex align-items-center gap-2">
            <i class="bi bi-exclamation-triangle"></i> @ViewBag.Error
        </div>
    }

    <form asp-action="Create" method="post">
        <div class="mb-3">
            <label class="form-label">Room</label>
            <select asp-for="RoomId" asp-items="ViewBag.Rooms" class="form-select"></select>
        </div>
        <div class="mb-3">
            <label class="form-label">Guest</label>
            <select asp-for="GuestId" asp-items="ViewBag.Guests" class="form-select"></select>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="CheckIn" class="form-label">Check-in</label>
                <input asp-for="CheckIn" type="date" class="form-control" />
            </div>
            <div class="col-md-6 mb-4">
                <label asp-for="CheckOut" class="form-label">Check-out</label>
                <input asp-for="CheckOut" type="date" class="form-control" />
            </div>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-brand"><i class="bi bi-check-lg"></i> Book</button>
            <a asp-action="Index" class="btn btn-light">Back</a>
        </div>
    </form>
</div>