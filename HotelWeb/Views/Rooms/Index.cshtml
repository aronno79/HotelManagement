@model List<HotelWeb.Models.Room>
@{ ViewData["Title"] = "Rooms"; }

<div class="page-header">
    <div>
        <h2>Rooms</h2>
        <p>@Model.Count ta room</p>
    </div>
    <a asp-action="Create" class="btn btn-brand"><i class="bi bi-plus-lg"></i> Add Room</a>
</div>

@if (!Model.Any())
{
    <div class="card-box empty-state"><i class="bi bi-door-closed"></i>Kono room nai. Prothom room add koro.</div>
}
else
{
    <div class="row g-4">
    @foreach (var r in Model)
    {
        var icon = r.RoomType == "Suite" ? "bi-stars" : r.RoomType == "Double" ? "bi-people" : "bi-person";
        <div class="col-sm-6 col-lg-4">
            <div class="card-box room-card">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="room-icon"><i class="bi @icon"></i></div>
                        <div>
                            <h3 class="room-no">@r.RoomNumber</h3>
                            <span class="text-muted small">@r.RoomType</span>
                        </div>
                    </div>
                    @if (r.IsAvailable)
                    {
                        <span class="badge-soft bg-soft-success">Available</span>
                    }
                    else
                    {
                        <span class="badge-soft bg-soft-danger">Occupied</span>
                    }
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <div class="room-price">৳@r.PricePerNight.ToString("N0") <small>/ night</small></div>
                    <div class="d-flex gap-1">
                        <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                        <form asp-action="Delete" asp-route-id="@r.Id" method="post" class="d-inline">
                            <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this room?')"><i class="bi bi-trash"></i></button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
    </div>
}