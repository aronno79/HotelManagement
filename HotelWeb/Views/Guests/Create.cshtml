@model HotelWeb.Models.Guest
@{ ViewData["Title"] = "Add Guest"; }

<div class="card-box form-card">
    <h3 class="mb-4 fw-bold">Add Guest</h3>
    <form asp-action="Create" method="post">
        <div class="mb-3">
            <label asp-for="FullName" class="form-label">Full Name</label>
            <input asp-for="FullName" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Phone" class="form-label">Phone</label>
            <input asp-for="Phone" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" class="form-control" />
        </div>
        <div class="mb-4">
            <label asp-for="NidOrPassport" class="form-label">NID / Passport</label>
            <input asp-for="NidOrPassport" class="form-control" />
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-brand"><i class="bi bi-check-lg"></i> Save</button>
            <a asp-action="Index" class="btn btn-light">Back</a>
        </div>
    </form>
</div>