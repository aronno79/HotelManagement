@model List<HotelWeb.Models.Guest>
@{ ViewData["Title"] = "Guests"; }

<div class="page-header">
    <div>
        <h2>Guests</h2>
        <p>@Model.Count jon guest</p>
    </div>
    <a asp-action="Create" class="btn btn-brand"><i class="bi bi-person-plus"></i> Add Guest</a>
</div>

<div class="card-box overflow-hidden">
@if (!Model.Any())
{
    <div class="empty-state"><i class="bi bi-people"></i>Kono guest nai.</div>
}
else
{
    <div class="table-responsive">
    <table class="table table-modern">
        <thead>
            <tr><th>Guest</th><th>Phone</th><th>Email</th><th>NID / Passport</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var g in Model)
        {
            <tr>
                <td>
                    <span class="avatar">@(g.FullName.Length > 0 ? g.FullName.Substring(0, 1).ToUpper() : "?")</span>
                    <strong>@g.FullName</strong>
                </td>
                <td>@g.Phone</td>
                <td>@g.Email</td>
                <td>@g.NidOrPassport</td>
                <td class="text-end">
                    <form asp-action="Delete" asp-route-id="@g.Id" method="post" class="d-inline">
                        <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this guest?')"><i class="bi bi-trash"></i></button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>
}
</div>